{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "source": "https://demo.istabot.com",
    "capturedAt": "2026-10-25",
    "method": "Chrome 154 computed styles plus public CSS bundles",
    "status": "verified unless marked inferred"
  },
  "color": {
    "background": { "page": "#f0f0f0", "surface": "#ffffff", "surfaceTranslucent": "#ffffff8c", "subtle": "#f7f7f8" },
    "brand": { "primary": "#003cbd", "link": "#0047db", "accent": "#1d4ed8", "bright": "#3b6ef5", "soft": "#eef2ff" },
    "text": { "primary": "#18181b", "heading": "#0a0a0a", "secondary": "#52525b", "muted": "#6b6b6b", "inverse": "#ffffff" },
    "border": { "default": "#e5e7eb", "soft": "#0000000a", "surfaceHighlight": "#ffffffe6" },
    "semantic": { "success": "#16a34a", "warning": "#d97706", "danger": "#ef4444" }
  },
  "font": {
    "family": { "primary": "Inter, Inter Fallback, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica Neue, Arial, sans-serif", "brand": "Sans, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica Neue, Arial, sans-serif" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "size": { "caption": "12px", "small": "14px", "body": "16px", "lead": "clamp(1.1rem, 1rem + .2vw, 1.2rem)", "cardHeading": "1.2rem", "sectionHeading": "clamp(2.3rem, 1.4rem + 2.6vw, 3.7rem)" },
    "lineHeight": { "body": "1.5", "lead": "1.6", "heading": "1.04", "cardHeading": "1.5" },
    "letterSpacing": { "display": "-.045em", "heading": "-.02em", "bodyTight": "-.01em" }
  },
  "layout": {
    "pageMax": "1440px", "headerHeight": "80px",
    "sectionPaddingDesktop": "96px 24px 112px", "sectionPaddingMobile": "72px 16px 80px",
    "heroPaddingDesktop": "80px 24px 72px", "heroPaddingTablet": "136px 24px 96px",
    "gridGap": { "small": "1.25rem", "medium": "1.5rem", "large": "2.5rem", "hero": "3.5rem" }
  },
  "radius": { "control": "8px", "navCta": "12px", "card": "14px", "innerPanel": "21px", "panel": "26px", "pricingOuter": "28px", "pill": "999px" },
  "shadow": {
    "card": "0 0 0 1px #0000000a, 0 14px 30px -18px #0f172a59",
    "glassPanel": "0 0 0 1px #ffffffe6, 0 1px 2px #0000000a, 0 18px 40px -30px #0000002e",
    "pricing": "0 0 0 1px #ffffffe6, 0 1px 2px #0000000a, 0 24px 48px -32px #0000002e",
    "primaryButton": "0 0.42px 0.93px -0.42px rgba(28,70,255,.13), 0 1.6px 3.52px -.83px rgba(28,70,255,.17), 0 7px 15.4px -1.25px rgba(28,70,255,.36)"
  },
  "breakpoint": { "phone": "480px", "mobile": "767px", "tablet": "1023px", "desktopNav": "1280px" },
  "transition": { "fast": "150ms cubic-bezier(.4,0,.2,1)", "standard": "300ms ease", "accordion": "350ms cubic-bezier(.22,1,.36,1)", "reveal": "700ms cubic-bezier(.22,1,.36,1)" }
}
